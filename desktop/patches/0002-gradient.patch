+/*
+Часть Margy — форка Telegram Desktop.
+*/
+#include "margy/margy_gradients.h"
+
+#include "api/api_messages_search.h"
+#include "base/flat_map.h"
+#include "data/data_peer.h"
+#include "data/data_session.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "main/main_session.h"
+
+#include <QtCore/QRegularExpression>
+
+namespace Margy {
+namespace {
+
+// Группа, в которой всё это лежит. Та же, что у андроидной Margy.
+const auto kGroup = u"margy_underground"_q;
+const auto kTag = u"#margy_gradient"_q;
+
+struct Store {
+	base::flat_map<PeerId, Gradient> colors;
+	std::unique_ptr<Api::MessagesSearch> search;
+	rpl::lifetime lifetime;
+	bool asked = false;
+};
+
+base::flat_map<not_null<Main::Session*>, std::unique_ptr<Store>> Stores;
+
+// Что мы согласны считать градиентом: ровно два цвета. Один — это заливка,
+// а больше двух шапка профиля всё равно не нарисует.
+[[nodiscard]] std::optional<Gradient> Parse(const QString &text) {
+	static const auto expression = QRegularExpression(
+		u"#margy_gradient\\s+([0-9A-Fa-f]{6})-([0-9A-Fa-f]{6})"_q);
+	const auto match = expression.match(text);
+	if (!match.hasMatch()) {
+		return {};
+	}
+	return Gradient{
+		QColor(u"#"_q + match.captured(1)),
+		QColor(u"#"_q + match.captured(2)),
+	};
+}
+
+[[nodiscard]] Store &StoreFor(not_null<Main::Session*> session) {
+	const auto i = Stores.find(session);
+	if (i != end(Stores)) {
+		return *i->second;
+	}
+	auto store = std::make_unique<Store>();
+	const auto raw = store.get();
+	Stores.emplace(session, std::move(store));
+	// Сессия уходит вместе с выходом из аккаунта, а наша память должна уйти
+	// с ней: иначе указатель останется висеть, и на следующем входе мы
+	// покрасим чужой профиль остатками прошлого.
+	session->lifetime().add([=] {
+		Stores.remove(session);
+	});
+	return *raw;
+}
+
+void Ensure(not_null<Main::Session*> session) {
+	auto &store = StoreFor(session);
+	if (store.asked) {
+		return;
+	}
+	store.asked = true;
+	// Группу не разыскиваем: если человек в ней не состоит и мы про неё
+	// ничего не знаем, то и градиентов ему взять неоткуда. Лезть в сеть
+	// ради этого при каждом открытии профиля — плохая цена за украшение.
+	const auto group = session->data().peerByUsername(kGroup);
+	if (!group) {
+		return;
+	}
+	const auto history = session->data().history(group);
+	store.search = std::make_unique<Api::MessagesSearch>(history);
+	store.search->messagesFounds(
+	) | rpl::on_next([=](const Api::FoundMessages &found) {
+		auto &store = StoreFor(session);
+		for (const auto &itemId : found.messages) {
+			const auto item = session->data().message(itemId);
+			if (!item) {
+				continue;
+			}
+			const auto from = item->from()->id;
+			// Поиск отдаёт от новых к старым, поэтому первое найденное для
+			// человека — самое свежее, и менять его на старое не нужно.
+			if (store.colors.contains(from)) {
+				continue;
+			}
+			if (const auto gradient = Parse(item->originalText().text)) {
+				store.colors.emplace(from, *gradient);
+			}
+		}
+	}, store.lifetime);
+	store.search->searchMessages({ .query = kTag });
+}
+
+} // namespace
+
+std::optional<Gradient> GradientFor(not_null<PeerData*> peer) {
+	const auto session = &peer->session();
+	Ensure(session);
+	auto &store = StoreFor(session);
+	const auto i = store.colors.find(peer->id);
+	return (i != end(store.colors))
+		? std::make_optional(i->second)
+		: std::nullopt;
+}
+
+} // namespace Margy
