@@ -0,0 +1,28 @@
+/*
+Часть Margy — форка Telegram Desktop.
+
+Градиент профиля: два своих цвета вместо тех, что выбирает телеграм.
+
+Живёт он не в приложении, а в общей группе: обычным сообщением с меткой
+«#margy_gradient AABBCC-DDEEFF». Чей это градиент, видно по автору сообщения,
+и подделать это нельзя — подпись под каждым сообщением ставит телеграм.
+Ровно так же устроена андроидная Margy, поэтому оба клиента читают одно и то
+же и договариваться им не о чем.
+*/
+#pragma once
+
+class PeerData;
+
+namespace Margy {
+
+struct Gradient {
+	QColor top;
+	QColor bottom;
+};
+
+// Пара цветов этого человека, если она уже прочитана. Заодно, при первом
+// спросе, запускает чтение — но никого не ждёт: пока не прочитано, профиль
+// рисуется как обычно, а перечитывать нечего.
+[[nodiscard]] std::optional<Gradient> GradientFor(not_null<PeerData*> peer);
+
+} // namespace Margy
