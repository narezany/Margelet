+        synchronized (waiting) {
+            resolving = false;
+            if (id != 0) {
+                groupId = id;
+                MargeletConfig.prefs().edit().putLong(KEY_GROUP, id).apply();
+            }
+            ready = new ArrayList<>(waiting);
+            waiting.clear();
+        }
+        for (Peer peer : ready) {
+            try {
+                peer.onPeer(id);
+            } catch (Throwable t) {
