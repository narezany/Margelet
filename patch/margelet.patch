+        do {
+            int from = at.start() - shift;
+            int to = at.end() - shift;
+            // Съедаем перевод строки следом, чтобы не оставлять пустую первую
+            // строку там, где метка стояла отдельно.
+            while (to < out.length() && (out.charAt(to) == '\n' || out.charAt(to) == ' ')) {
+                to++;
+            }
+            out.delete(from, to);
+            shift += to - from;
+        } while (at.find());
+        return out;
+    }
