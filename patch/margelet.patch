diff --git a/TMessagesProj_AppStandalone/src/main/python/margelet_example.py b/TMessagesProj_AppStandalone/src/main/python/margelet_example.py
new file mode 100644
index 000000000..14308d17a
--- /dev/null
+++ b/TMessagesProj_AppStandalone/src/main/python/margelet_example.py
@@ -0,0 +1,135 @@
+# -*- coding: utf-8 -*-
+"""Пример плагина Margelet.
+
+Показывает всё, что плагину дают: свой экран настроек, шесть событий,
+кнопку в меню чата и подмену чужого метода. Каждая часть выключена по
+умолчанию — плагин, который сразу лезет в переписку, плохой пример.
+
+Код лежит исходником и читается кем угодно — это условие форума.
+"""
+
+
+def on_start():
+    margelet.settings(
+        margelet.header("Что делать"),
+        margelet.switch("greet", "Здороваться при открытии чата",
+                        about="Короткая надпись поверх экрана, когда открываешь переписку."),
+        margelet.switch("sign", "Подписывать отправляемое",
+                        about="Дописывает подпись в конец каждого сообщения, которое ты шлёшь."),
+        margelet.text("signature", "Подпись", default="🌿"),
+        margelet.switch("count", "Считать входящие"),
+        margelet.switch("watch_deleted", "Замечать удалённые",
+                        about="Пишет в консоль, сколько сообщений исчезло. Сам текст не сохраняется."),
+        margelet.switch("keep_pins", "Не закреплять каналы",
+                        about="Отменяет закрепление канала. Обычные переписки закрепляются как всегда."),
+        margelet.switch("hook", "Показать подмену метода",
+                        about="Подменяет один безобидный метод приложения и пишет в консоль, что он ответил. "
+                              "Нужны включённые хуки в настройках плагинов."),
+        margelet.note("Всё это остаётся на телефоне и никуда не уходит."),
+        margelet.action("Сбросить счёт", forget, danger=True),
+    )
+
+    margelet.on_chat_opened(opened)
+    margelet.on_send(sign)
+    margelet.on_message(count)
+    margelet.on_deleted(vanished)
+    margelet.on_pin(pinning)
+    margelet.on_settings(changed)
+    margelet.button("Сколько насчитал", report)
+
+    if margelet.flag("hook"):
+        watch_muted()
+
+    margelet.log("привет из плагина", margelet.name)
+
+
+def opened(chat):
+    """Открыли переписку. Сам экран чата приходит сюда как есть."""
+    if margelet.flag("greet"):
+        margelet.toast("привет!")
+
+
+def sign(text, dialog_id):
+    """Перед отправкой. Вернуть строку — уйдёт она, вернуть False — не уйдёт.
+
+    Приложение ждёт этого ответа, поэтому здесь нельзя долго думать: пока
+    думаем, человек смотрит на неотправленное сообщение.
+    """
+    if not margelet.flag("sign"):
+        return None
+    signature = margelet.get("signature", "")
+    if not signature or text.endswith(signature):
+        return None
+    return text + " " + signature
+
+
+def count(text, dialog_id, message_id, mine):
+    """Пришло сообщение. Своё отправленное приходит сюда же — на то и mine."""
+    if mine or not margelet.flag("count"):
+        return
+    margelet.set("counted", int(margelet.get("counted", "0")) + 1)
+
+
+def vanished(ids, chat):
+    """Сообщения удалили. Ответ ни на что не влияет: их уже нет.
+
+    Текста здесь нет и быть не может — сообщение к этому времени пропало.
+    Кому нужен текст удалённого, тот должен был запомнить его раньше, в
+    on_message; пример нарочно этого не делает.
+    """
+    if margelet.flag("watch_deleted"):
+        margelet.log("исчезло сообщений:", len(ids), "в", chat)
+
+
+def pinning(chat, pin):
+    """Чат закрепляют. Вернуть False — не закреплять.
+
+    Приложение ждёт ответа, как и на отправке: долгую работу отсюда надо
+    уносить в margelet.background.
+    """
+    if not margelet.flag("keep_pins"):
+        return None
+    if pin and chat < 0:
+        margelet.toast("каналы не закрепляем")
+        return False
+    return None
+
+
+def watch_muted():
+    """Подменить чужой метод и посмотреть, что он ответил.
+
+    Спрашиваем hooks_work() до того, как рассчитывать на подмену: хуки
+    выключены по умолчанию и поднимаются не на каждом андроиде. Плагин, не
+    умеющий обойтись без хука, — сломанный плагин, а не смелый.
+    """
+    if not margelet.hooks_work():
+        margelet.log("хуков нет:", margelet.hooks_why())
+        return
+
+    ok = margelet.hook(
+        "org.telegram.messenger.MessagesController",
+        "isDialogMuted",
+        args=["long", "long"],
+        after=muted,
+    )
+    margelet.log("подмена метода:", "встала" if ok else "не встала")
+
+
+def muted(call):
+    """После вызова. Ответ можно и подменить — здесь только смотрим."""
+    margelet.log("тихий диалог?", call.getResult())
+
+
+def report(chat):
+    """Нажали строчку плагина в меню чата."""
+    margelet.toast("насчитал " + margelet.get("counted", "0"))
+
+
+def forget():
+    """Кнопка на экране настроек."""
+    margelet.set("counted", "0")
+    margelet.toast("счёт сброшен")
+
+
+def changed(key, value):
+    margelet.log("настройка", key, "теперь", value)
